{
  "python.terminal.activateEnvironment": true,
  "terminal.integrated.profiles.windows": {
    "PowerShell (venv)": {
      "source": "PowerShell",
      "args": [
        "-NoExit",
        "-Command",
        "$dir = (Get-Location).Path; while ($dir) { $activate = Join-Path $dir '.venv\\Scripts\\Activate.ps1'; if (Test-Path $activate) { & $activate; break }; $parent = Split-Path $dir -Parent; if ($parent -eq $dir) { break }; $dir = $parent }"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (venv)",
  "python-envs.pythonProjects": [
    {
      "path": "02_supabase-ai-backend",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "03_supabase-ai-frontend/03_api-integration",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "05_llm-agent-orchestration",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "05_llm-agent-orchestration/04_rag",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "05_llm-agent-orchestration/07_human-approval-and-safety",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "07_multi-agent-service-ops",
      "envManager": "ms-python.python:venv",
      "packageManager": "ms-python.python:pip"
    },
    {
      "path": "07_multi-agent-service-ops/00_runtime-and-deployment/01_simple-multi-llm-compose",
